rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Accessibility place photos: ownership-aware upload by signed-in users
    // Path structure: places/{placeId}/{userId}/{fileName}
    match /places/{placeId}/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Pending submission images: owner (by uid in path) OR staff via custom claim can READ; owner can WRITE (image, <=5MB).
    match /place_photo_submissions/{uid}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role in ['admin','moderator']);
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Approved public photos
    match /place_photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role in ['admin','moderator'];
    }

    // Explicit deny for all other unmatched paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
