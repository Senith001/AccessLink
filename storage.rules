rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Accessibility place photos: ownership-aware upload by signed-in users
    // Path structure: places/{placeId}/{userId}/{fileName}
    match /places/{placeId}/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Explicit deny for all other unmatched paths - remove unrestricted catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
