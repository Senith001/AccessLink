rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isStaff() {
      // Check both Firestore document role AND custom claims role for backward compatibility
      // The backend keeps both in sync, but this provides redundancy
      // Custom claims are faster (no doc read) but doc check ensures consistency
      return isSignedIn() && (
        (userRole() == 'admin' || userRole() == 'moderator') ||
        (request.auth.token.role in ['admin', 'moderator'])
      );
    }

    // Users collection - auth-based access with role protection
    match /users/{uid} {
      // Users can read own doc; staff can read any
      allow read: if isOwner(uid) || isStaff();
      
      // New users cannot self-assign elevated role
      allow create: if isOwner(uid) && request.resource.data.role == 'user';
      
      // Owner cannot change their own role (no self-escalation); staff may update including role
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role) || isStaff();
      
      // Only staff can delete users
      allow delete: if isStaff();
      
      // Favorites subcollection - per-user private data
      match /favorites/{placeId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Categories collection - public read, staff-curated content
    match /categories/{categoryId} {
      allow read: if true; // Public
      allow write: if isStaff(); // Curated content
    }

    // Places collection - public read, staff-managed content
    match /places/{placeId} {
      allow read: if true; // Public
      allow create, delete: if isStaff();
      // Staff have full update rights; authenticated users can update community ratings and photo arrays
      allow update: if isStaff() || (
        isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingAverage', 'ratingCount', 'photos', 'updatedAt'])
      );
    }

    // Reviews collection - public read, authenticated create/update
    match /reviews/{reviewId} {
      allow read: if true; // Public
      // Contribution open to all userTypes - any authenticated user can create reviews with 1-5 rating
      allow create: if isSignedIn() && 
                       request.resource.data.userId == request.auth.uid && 
                       request.resource.data.rating is int && 
                       request.resource.data.rating >= 1 && 
                       request.resource.data.rating <= 5;
      // Author manages own (rating must remain 1-5 int); staff can manage any
      allow update: if (isSignedIn() && 
                        resource.data.userId == request.auth.uid && 
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.rating is int &&
                        request.resource.data.rating >= 1 && 
                        request.resource.data.rating <= 5) || isStaff();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isStaff();
    }

    // Reports collection - authenticated filing, staff management
    match /reports/{reportId} {
      // Open to all userTypes - any authenticated user can file a report; must start pending
      allow create: if isSignedIn() && 
                       request.resource.data.reportedBy == request.auth.uid && 
                       request.resource.data.status == 'pending';
      // Staff see all; reporter sees own
      allow read: if isStaff() || (isSignedIn() && resource.data.reportedBy == request.auth.uid);
      // Only staff change status/apply moderation actions
      allow update, delete: if isStaff();
    }

    // Photos collection - public read, authenticated upload
    match /photos/{photoId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uploaderId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.uploaderId == request.auth.uid) || isStaff();
    }

    // Verification records - public read, staff-managed
    match /verification_records/{recordId} {
      allow read: if true; // Public - supports viewing verified info
      allow write: if isStaff();
    }

    // Contributions collection - submission workflow for pending review
    match /contributions/{docId} {
      // Users can create contributions with pending status and their own submittedBy field
      allow create: if isSignedIn() && request.resource.data.submittedBy == request.auth.uid && request.resource.data.status == 'pending';
      // Staff can read all; users can read their own submissions
      allow read:   if isStaff() || (isSignedIn() && resource.data.submittedBy == request.auth.uid);
      // Only staff can update and delete contributions (for moderation workflow)
      allow update, delete: if isStaff();
    }

    // Accessibility features collection - submission workflow for pending review
    match /accessibility_features/{docId} {
      // Users can create accessibility features with pending status and their own submittedBy field
      allow create: if isSignedIn() && request.resource.data.submittedBy == request.auth.uid && request.resource.data.status == 'pending';
      // Staff can read all; users can read their own submissions
      allow read:   if isStaff() || (isSignedIn() && resource.data.submittedBy == request.auth.uid);
      // Only staff can update and delete accessibility features (for moderation workflow)
      allow update, delete: if isStaff();
    }

    // Catch-all deny rule - earlier specific matches take precedence
    match /{document=**} {
      allow read, write: if false; // Default deny for any unmatched paths
    }
  }
}